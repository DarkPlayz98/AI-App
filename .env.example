# Gemini API key (server-side only, used by prompt enhancement)
GEMINI_API_KEY=your_gemini_api_key_here

# Hugging Face token (server-side only, used by image generation)
# Create a token with Inference permissions on Hugging Face.
HF_TOKEN=your_huggingface_token_here

# Optional protection for the custom API endpoint.
ORIGIN_API_KEY=change_this_to_a_long_random_key

# API server
PORT=3000

# Optional comma-separated browser origins. Use * for development only.
CORS_ORIGINS=*
